import React, { useEffect, useState } from "react";
import { auth, db } from "../firebase";
import { collection, query, where, onSnapshot, updateDoc, doc } from "firebase/firestore";

export default function ProviderDashboard() {
  const [myJobs, setMyJobs] = useState([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    const user = auth.currentUser;
    if (!user) {
      setLoading(false);
      return;
    }

    const q = query(collection(db, "jobs"), where("providerId", "==", user.uid));
    const unsub = onSnapshot(q, (snap) => {
      setMyJobs(snap.docs.map(d => ({ id: d.id, ...d.data() })));
      setLoading(false);
    });
    return () => unsub();
  }, []);

  const changeStatus = async (id, newStatus) => {
    await updateDoc(doc(db, "jobs", id), { status: newStatus });
  };

  if (loading) return <div className="p-6">Loading...</div>;

  return (
    <div>
      <h2 className="text-2xl text-brandRed font-bold mb-4">Your Jobs</h2>
      {myJobs.length === 0 ? <p className="text-gray-400">No assigned jobs.</p> :
        <ul className="space-y-3">
          {myJobs.map(j => (
            <li key={j.id} className="card">
              <h3 className="font-semibold">{j.title}</h3>
              <p className="text-gray-300">{j.description}</p>
              <p className="text-sm text-gray-400">Status: {j.status}</p>
              <div className="mt-2 flex gap-2">
                {j.status !== "in-progress" && <button onClick={()=>changeStatus(j.id, "in-progress")} className="btn btn-primary">Start</button>}
                {j.status !== "completed" && <button onClick={()=>changeStatus(j.id, "completed")} className="btn bg-green-600">Complete</button>}
              </div>
            </li>
          ))}
        </ul>
      }
    </div>
  );
}
