import React, { useEffect, useState } from "react";
import { collection, query, where, onSnapshot } from "firebase/firestore";
import { db } from "../firebase/firebase.js";
import { useAuth } from "../auth/AuthProvider.jsx";

export default function CalendarPage() {
  const { user } = useAuth();
  const [jobs, setJobs] = useState([]);

  useEffect(() => {
    if(!user) return;
    const q = query(collection(db, "jobs"), where("providerId", "==", user.uid));
    const unsub = onSnapshot(q, snap => setJobs(snap.docs.map(d=>({ id:d.id, ...d.data() }))));
    return ()=>unsub();
  }, [user]);

  return (
    <div className="p-6 max-w-3xl mx-auto">
      <h1 className="text-2xl font-bold mb-4 text-center">Your Job Calendar</h1>
      {jobs.length===0 ? <p className="text-center text-gray-500">No jobs assigned yet.</p> :
      <ul className="space-y-3">
        {jobs.map(j => (
          <li key={j.id} className="border p-3 rounded bg-white">
            <div className="font-semibold">{j.serviceName}</div>
            <div className="text-sm text-gray-500">{j.date} • {j.location}</div>
            <div className="mt-2">Status: <strong>{j.status}</strong></div>
          </li>
        ))}
      </ul>}
    </div>
  );
}
