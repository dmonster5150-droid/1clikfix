@tailwind base;
@tailwind components;
@tailwind utilities;

body {
  @apply bg-black text-white;
  font-family: "Inter", sans-serif;
}

button {
  @apply rounded-xl px-4 py-2 font-semibold transition-all;
}

.btn-primary {
  @apply bg-red-600 hover:bg-red-700 text-white;
}

.card {
  @apply bg-gray-900 p-4 rounded-2xl shadow-md;
}
