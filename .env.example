# Firebase (fill in on Netlify)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=1clikfix-prod
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Google OAuth
VITE_GOOGLE_CLIENT_ID=

# Square (public values ok in VITE_, access token must NOT be VITE_)
VITE_SQUARE_APPLICATION_ID=
VITE_SQUARE_LOCATION_ID=
VITE_SQUARE_ENV=sandbox
# Secret (set as Netlify env var, do NOT put into code files)
SQUARE_ACCESS_TOKEN=

# Site URL (Netlify site URL or custom domain)
VITE_SITE_URL=https://your-site.netlify.app
